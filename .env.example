# Copia este archivo como ".env" y completa tus valores:  cp .env.example .env
# (en Windows: copy .env.example .env). El archivo .env NO se sube a git.

# --- Modelo de lenguaje (el "cerebro" del agente) ---------------------------
# api  = LLM real vía API compatible con OpenAI (recomendado para la demo)
# mock = SIN IA: sustituto de reglas, solo para probar el sistema offline
LLM_PROVIDER=api

# Tu clave. Con Google AI Studio (https://aistudio.google.com/apikey) hay una capa gratuita.
LLM_API_KEY=

# Endpoint compatible con OpenAI. Valores por defecto para Gemini:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Los nombres de modelo cambian con el tiempo (gemini-2.5-flash ya no está disponible para cuentas nuevas).
# Si aparece un error 404, lista los modelos que ve TU clave con:  python main.py models
# y elige uno que soporte "function calling". Luego verifica con: python main.py check
LLM_MODEL=gemini-3.8-flash
# Temperatura baja = decisiones más estables. Déjala vacía si tu modelo no acepta el parámetro.
LLM_TEMPERATURE=0.2

# Otras opciones (descomenta UNA combinación):
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=<modelo local con soporte de herramientas>

# --- Simulación (opcional, hay valores por defecto) --------------------------
# INITIAL_CASH=10000
# MAX_TRADE_PCT=0.25
# MAX_BTC_POSITION=0.10
# STOP_LOSS_PCT=0.05
# MAX_LOSS_PCT=0.20

# IMPORTANTE: este proyecto NO usa ni necesita claves de ningún exchange.
# No agregues claves de Binance u otros exchanges: solo se usan datos públicos.
